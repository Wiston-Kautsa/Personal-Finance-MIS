<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ProjectHistoryLifecycleController" styleClass="core-workspace-page project-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Project History &amp; Lifecycle" styleClass="section-heading"/>
            <Label text="A read-focused audit trail of project profile changes, activities, finances and lifecycle status." wrapText="true" styleClass="form-note"/>
        </VBox>
        <Button text="Finances" onAction="#openFinances" styleClass="primary-button"/>
        <Button text="Milestones" onAction="#openMilestones" styleClass="secondary-button"/>
        <Button text="Activities" onAction="#openActivities" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TitledPane text="Project Lifecycle State" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Project" styleClass="field-label"/>
                <ComboBox fx:id="projectBox" promptText="Choose project" minWidth="300"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Active" onAction="#markActive" styleClass="secondary-button"/>
                <Button text="Paused" onAction="#markPaused" styleClass="secondary-button"/>
                <Button text="Completed" onAction="#markCompleted" styleClass="primary-button"/>
                <Button text="Archived" onAction="#archiveProject" styleClass="danger-button"/>
            </HBox>
            <GridPane hgap="12" vgap="12">
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Budget" styleClass="metric-title"/>
                    <Label fx:id="budgetLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Spent" styleClass="metric-title"/>
                    <Label fx:id="spentLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Status" styleClass="metric-title"/>
                    <Label fx:id="statusLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Type / Owner" styleClass="metric-title"/>
                    <Label fx:id="typeOwnerLabel" text="-" styleClass="overview-value"/>
                </VBox>
            </GridPane>
        </VBox>
    </TitledPane>

    <HBox spacing="14" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <TitledPane text="History Timeline" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <TextArea fx:id="historyArea" editable="false" wrapText="true" prefRowCount="20" VBox.vgrow="ALWAYS"/>
        </TitledPane>
        <VBox spacing="14" HBox.hgrow="ALWAYS">
            <TitledPane text="Activity Trail" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
                <VBox spacing="10">
                    <Label fx:id="activityStateLabel" text="No project activities." styleClass="form-note"/>
                    <TableView fx:id="activityTable" prefHeight="230" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="activityDateColumn" text="Date" prefWidth="125"/>
                            <TableColumn fx:id="activityNameColumn" text="Activity" prefWidth="230"/>
                            <TableColumn fx:id="activityProgressColumn" text="Progress" prefWidth="130"/>
                            <TableColumn fx:id="activityStatusColumn" text="Status" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>
            <TitledPane text="Financial Trail" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
                <VBox spacing="10">
                    <Label fx:id="transactionStateLabel" text="No project transactions." styleClass="form-note"/>
                    <TableView fx:id="transactionTable" prefHeight="230" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="transactionDateColumn" text="Date" prefWidth="125"/>
                            <TableColumn fx:id="transactionDescriptionColumn" text="Description" prefWidth="260"/>
                            <TableColumn fx:id="transactionAmountColumn" text="Amount" prefWidth="145"/>
                            <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>
        </VBox>
    </HBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
