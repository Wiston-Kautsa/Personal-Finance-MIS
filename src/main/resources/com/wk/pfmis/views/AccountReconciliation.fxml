<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.AccountReconciliationController"
      styleClass="account-reconciliation-page">
    <HBox spacing="10" styleClass="account-summary-strip" VBox.vgrow="NEVER">
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Accounts Needing Reconciliation" styleClass="metric-title"/>
            <Label fx:id="needsReconciliationCountLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Selected System Balance" styleClass="metric-title"/>
            <Label fx:id="selectedSystemBalanceLabel" text="-" styleClass="overview-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Difference" styleClass="metric-title"/>
            <Label fx:id="selectedDifferenceLabel" text="-" styleClass="overview-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile account-summary-wide">
            <Label text="Reconciliation Status" styleClass="metric-title"/>
            <Label fx:id="selectedStatusLabel" text="Select an account" wrapText="true" styleClass="overview-value"/>
        </VBox>
    </HBox>

    <TitledPane text="Reconciliation Workbench" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="16" vgap="10">
                <Label text="Account" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="accountBox" promptText="Select account" maxWidth="Infinity" minHeight="34" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <Label text="Reconciliation Date" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <DatePicker fx:id="reconciliationDatePicker" maxWidth="Infinity" minHeight="34" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="System Balance" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="systemBalanceField" editable="false" maxWidth="Infinity" minHeight="34" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                <Label text="Actual Balance" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="actualBalanceField" promptText="Actual balance from statement, cash count, or wallet" maxWidth="Infinity" minHeight="34" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Difference" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="differenceField" editable="false" maxWidth="Infinity" minHeight="34" prefHeight="34" GridPane.columnIndex="0" GridPane.rowIndex="5"/>

                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextArea fx:id="notesArea" promptText="Statement reference, cash-count notes, investigation details, or adjustment explanation"
                          prefRowCount="3" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2"/>
            </GridPane>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="messageLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#refresh" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                <Button fx:id="saveReconciliationButton" text="Save Reconciliation" onAction="#saveReconciliation" minHeight="34" prefHeight="34" styleClass="account-save-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Accounts That Need Reconciliation" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TableView fx:id="needsReconciliationTable" prefHeight="190">
            <columns>
                <TableColumn fx:id="needsAccountColumn" text="Account" prefWidth="220"/>
                <TableColumn fx:id="needsBalanceColumn" text="System Balance" prefWidth="150"/>
                <TableColumn fx:id="needsLatestDateColumn" text="Latest Date" prefWidth="130"/>
                <TableColumn fx:id="needsDifferenceColumn" text="Latest Difference" prefWidth="160"/>
                <TableColumn fx:id="needsStatusColumn" text="Status" prefWidth="120"/>
            </columns>
        </TableView>
    </TitledPane>

    <TitledPane text="Previous Reconciliation Records" collapsible="true" expanded="true" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="section-pane">
        <TableView fx:id="reconciliationTable" prefHeight="260" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="historyAccountColumn" text="Account" prefWidth="210"/>
                <TableColumn fx:id="historyDateColumn" text="Date" prefWidth="120"/>
                <TableColumn fx:id="historySystemBalanceColumn" text="System Balance" prefWidth="150"/>
                <TableColumn fx:id="historyActualBalanceColumn" text="Actual Balance" prefWidth="150"/>
                <TableColumn fx:id="historyDifferenceColumn" text="Difference" prefWidth="140"/>
                <TableColumn fx:id="historyStatusColumn" text="Status" prefWidth="110"/>
                <TableColumn fx:id="historyNotesColumn" text="Notes" prefWidth="260"/>
            </columns>
        </TableView>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
