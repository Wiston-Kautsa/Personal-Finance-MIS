<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.DataRecordsSectionController"
      spacing="12" styleClass="content-view">
    <Label fx:id="sectionTitleLabel" text="Sync and Recovery" styleClass="view-title"/>
    <TabPane fx:id="dataRecordsTabs" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="setup-tab-pane">
        <tabs>
            <Tab fx:id="syncStatusTab" text="Sync Status"/>
            <Tab fx:id="pendingQueueTab" text="Pending Queue"/>
            <Tab fx:id="failedRecordsTab" text="Failed Records"/>
            <Tab fx:id="conflictsTab" text="Conflicts"/>
            <Tab fx:id="quarantineTab" text="Quarantine"/>
            <Tab fx:id="syncHistoryTab" text="Sync History"/>
            <Tab fx:id="recoveryTab" text="Recovery"/>
        </tabs>
    </TabPane>
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</VBox>
