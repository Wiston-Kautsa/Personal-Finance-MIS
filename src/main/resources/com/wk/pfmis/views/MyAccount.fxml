<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.MyAccountController"
      spacing="14" styleClass="content-view">
    <Label text="My Account and Security" styleClass="view-title"/>
    <Label fx:id="workspaceLabel" wrapText="true" styleClass="workspace-security-label"/>

    <TitledPane text="Signed-in User" expanded="true" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
        <GridPane hgap="18" vgap="12">
            <Label text="Full name" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="fullNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Username" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="usernameLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Email" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Role" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="roleLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="Change Password" expanded="true" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="10">
            <VBox spacing="5">
                <Label text="Current password" styleClass="form-label"/>
                <PasswordField fx:id="currentPasswordField" promptText="Current password" maxWidth="420"/>
            </VBox>
            <VBox spacing="5">
                <Label text="New password" styleClass="form-label"/>
                <PasswordField fx:id="newPasswordField" promptText="New password" maxWidth="420"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Confirm new password" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password" maxWidth="420"/>
            </VBox>
            <Label text="Use at least 8 characters with uppercase, lowercase and a number." styleClass="muted-label"/>
            <Button text="Change Password" onAction="#changePassword" styleClass="primary-button"/>
            <Label fx:id="messageLabel" wrapText="true" styleClass="status-message"/>
        </VBox>
    </TitledPane>
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</VBox>
