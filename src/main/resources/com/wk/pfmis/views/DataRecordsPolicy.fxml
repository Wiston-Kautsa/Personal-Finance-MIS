<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wk.pfmis.controllers.DataRecordsPolicyController"
            styleClass="settings-scroll">
    <content>
        <VBox spacing="12" styleClass="settings-page data-record-policy-page">
            <VBox spacing="6" styleClass="panel data-record-hero">
                <Label fx:id="policyTitleLabel" text="Data Governance" styleClass="section-heading"/>
                <Label fx:id="policySubtitleLabel" text="Data and Records governance area." wrapText="true" styleClass="form-note"/>
                <Label fx:id="policyStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
            </VBox>

            <FlowPane hgap="12" vgap="12" prefWrapLength="980">
                <VBox spacing="5" styleClass="data-wireframe-card">
                    <Label text="Process Phase" styleClass="field-label"/>
                    <Label fx:id="phaseLabel" text="Governance" wrapText="true" styleClass="settings-status-title"/>
                </VBox>
                <VBox spacing="5" styleClass="data-wireframe-card">
                    <Label text="Primary Owner" styleClass="field-label"/>
                    <Label fx:id="ownerLabel" text="Administrator" wrapText="true" styleClass="settings-status-title"/>
                </VBox>
                <VBox spacing="5" styleClass="data-wireframe-card">
                    <Label text="Risk Level" styleClass="field-label"/>
                    <Label fx:id="riskLabel" text="Controlled" wrapText="true" styleClass="settings-status-title"/>
                </VBox>
                <VBox spacing="5" styleClass="data-wireframe-card-wide">
                    <Label text="Financial Impact" styleClass="field-label"/>
                    <Label fx:id="impactLabel" text="No direct financial posting from this page." wrapText="true" styleClass="settings-status-title"/>
                </VBox>
            </FlowPane>

            <TitledPane text="Professional Process Wireframe" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="12" styleClass="settings-section">
                    <Label text="Workflow Steps" styleClass="table-title"/>
                    <FlowPane fx:id="workflowStepsPane" hgap="10" vgap="10" prefWrapLength="980"/>
                    <Label text="Expected Screen Inputs / Columns" styleClass="table-title"/>
                    <FlowPane fx:id="wireframeFieldsPane" hgap="10" vgap="10" prefWrapLength="980"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Process Buttons" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="10" styleClass="settings-section">
                    <Label text="Every button below is wired to a safe action: preview, validate, request, export, log evidence or create backup. Destructive execution remains restricted to the controlled maintenance workflow." wrapText="true" styleClass="form-note"/>
                    <FlowPane fx:id="processActionsPane" hgap="8" vgap="8" prefWrapLength="980"/>
                </VBox>
            </TitledPane>

            <FlowPane hgap="12" vgap="12" prefWrapLength="980">
                <TitledPane text="Lifecycle / Workflow" collapsible="true" expanded="true" prefWidth="480" styleClass="section-pane">
                    <TextArea fx:id="lifecycleArea" editable="false" wrapText="true" prefRowCount="8" styleClass="data-policy-text"/>
                </TitledPane>
                <TitledPane text="Required Controls" collapsible="true" expanded="true" prefWidth="480" styleClass="section-pane">
                    <TextArea fx:id="controlsArea" editable="false" wrapText="true" prefRowCount="8" styleClass="data-policy-text"/>
                </TitledPane>
                <TitledPane text="Permissions" collapsible="true" expanded="true" prefWidth="480" styleClass="section-pane">
                    <TextArea fx:id="permissionsArea" editable="false" wrapText="true" prefRowCount="8" styleClass="data-policy-text"/>
                </TitledPane>
                <TitledPane text="Evidence and Audit Requirements" collapsible="true" expanded="true" prefWidth="480" styleClass="section-pane">
                    <TextArea fx:id="evidenceArea" editable="false" wrapText="true" prefRowCount="8" styleClass="data-policy-text"/>
                </TitledPane>
            </FlowPane>

            <TitledPane text="Safe Actions" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="10" styleClass="settings-section">
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="primaryActionButton" text="Review" onAction="#runPrimaryAction" minWidth="150" styleClass="primary-button"/>
                        <Button fx:id="requestActionButton" text="Create Request" onAction="#createGovernanceRequest" minWidth="160" styleClass="secondary-button"/>
                        <Button fx:id="backupActionButton" text="Backup Now" onAction="#backupNow" minWidth="120" styleClass="secondary-button"/>
                        <Button text="View Recent History" onAction="#viewRecentHistory" minWidth="160" styleClass="secondary-button"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TextArea fx:id="resultArea" editable="false" wrapText="true" prefRowCount="12" styleClass="ai-answer-area"/>
                </VBox>
            </TitledPane>

            <padding>
                <Insets top="4" right="4" bottom="12" left="4"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
