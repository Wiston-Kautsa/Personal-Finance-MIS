<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.PlannedRecurringExpensesController" styleClass="core-workspace-page expense-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Planned &amp; Recurring Expenses" styleClass="section-heading"/>
            <Label text="Plan obligations and repeating expenses without creating paid expense transactions until money actually leaves an account." wrapText="true" styleClass="form-note"/>
        </VBox>
        <Button text="+ Record Expense" onAction="#openRecordExpense" styleClass="primary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Planned Obligations">
                <VBox spacing="14">
                    <TitledPane text="Obligation Details" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                        <VBox spacing="12">
                            <GridPane hgap="18" vgap="10">
                                <Label text="Obligation Name *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="obligationNameField" promptText="Rent, fees, insurance" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label text="Amount *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <TextField fx:id="obligationAmountField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="Due Date *" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <DatePicker fx:id="obligationDueDatePicker" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Label text="Type" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="obligationTypeBox" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="Frequency" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="obligationFrequencyBox" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label text="Paying Account *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="obligationAccountBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                <Label text="Category" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="obligationCategoryBox" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                <Label text="Project" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="obligationProjectBox" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                                <Label text="Status" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <ComboBox fx:id="obligationStatusBox" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                <TextArea fx:id="obligationNotesArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.columnSpan="3"/>
                            </GridPane>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="Save Planned Expense" onAction="#saveObligation" styleClass="primary-button"/>
                                <Button text="Clear" onAction="#clearObligationForm" styleClass="secondary-button"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="obligationResultLabel" text="Select an obligation to edit, or create a new planned expense." wrapText="true" styleClass="form-note"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                    <TitledPane text="Planned Expense Schedule" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="10">
                            <Label fx:id="obligationStateLabel" text="No planned expense obligations." styleClass="form-note"/>
                            <TableView fx:id="obligationsTable" prefHeight="300" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="obligationNameColumn" text="Obligation" prefWidth="220"/>
                                    <TableColumn fx:id="obligationDueColumn" text="Due Date" prefWidth="125"/>
                                    <TableColumn fx:id="obligationAccountColumn" text="Paying Account" prefWidth="190"/>
                                    <TableColumn fx:id="obligationCategoryColumn" text="Category" prefWidth="170"/>
                                    <TableColumn fx:id="obligationAmountColumn" text="Amount" prefWidth="150"/>
                                    <TableColumn fx:id="obligationFrequencyColumn" text="Frequency" prefWidth="130"/>
                                    <TableColumn fx:id="obligationStatusColumn" text="Status" prefWidth="130"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </TitledPane>
                </VBox>
            </Tab>
            <Tab text="Recurring Expense Plans">
                <VBox spacing="14">
                    <TitledPane text="Recurring Plan Details" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                        <VBox spacing="12">
                            <GridPane hgap="18" vgap="10">
                                <Label text="Plan Name *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="planNameField" promptText="Electricity, subscription, rent" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label text="Amount *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <TextField fx:id="planAmountField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="Next Due Date *" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <DatePicker fx:id="planNextDueDatePicker" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Label text="Frequency" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="planFrequencyBox" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="Paying Account *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="planAccountBox" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label text="Category" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="planCategoryBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                <Label text="Project" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="planProjectBox" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                <Label text="Status" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="planStatusBox" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <TextArea fx:id="planNotesArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="4"/>
                            </GridPane>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="Save Recurring Expense" onAction="#saveRecurringExpense" styleClass="primary-button"/>
                                <Button text="Clear" onAction="#clearRecurringForm" styleClass="secondary-button"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="planResultLabel" text="Select a recurring expense plan to edit, or create a new one." wrapText="true" styleClass="form-note"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                    <TitledPane text="Recurring Expense Schedule" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
                        <VBox spacing="10">
                            <Label fx:id="planStateLabel" text="No recurring expense plans." styleClass="form-note"/>
                            <TableView fx:id="recurringExpenseTable" prefHeight="300" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="planNameColumn" text="Plan" prefWidth="220"/>
                                    <TableColumn fx:id="planDueColumn" text="Next Due" prefWidth="125"/>
                                    <TableColumn fx:id="planAccountColumn" text="Paying Account" prefWidth="190"/>
                                    <TableColumn fx:id="planCategoryColumn" text="Category" prefWidth="170"/>
                                    <TableColumn fx:id="planAmountColumn" text="Amount" prefWidth="150"/>
                                    <TableColumn fx:id="planFrequencyColumn" text="Frequency" prefWidth="130"/>
                                    <TableColumn fx:id="planStatusColumn" text="Status" prefWidth="130"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </TitledPane>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
