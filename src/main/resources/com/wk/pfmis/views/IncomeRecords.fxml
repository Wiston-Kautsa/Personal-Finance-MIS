<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.IncomeRecordsController">
    <Label text="Income Records" styleClass="section-heading"/>
    <Label text="Find saved income transactions, open the selected record, or choose one lifecycle action." wrapText="true" styleClass="form-note"/>

    <TitledPane text="Search Income" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <FlowPane hgap="14" vgap="10">
                <VBox spacing="4">
                    <Label text="Period" styleClass="field-label"/>
                    <ComboBox fx:id="periodBox" prefWidth="170"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Account" styleClass="field-label"/>
                    <ComboBox fx:id="accountFilterBox" prefWidth="210"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Income Source" styleClass="field-label"/>
                    <ComboBox fx:id="sourceFilterBox" prefWidth="210"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Status" styleClass="field-label"/>
                    <ComboBox fx:id="statusFilterBox" prefWidth="170"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Search" styleClass="field-label"/>
                    <TextField fx:id="searchField" promptText="Reference or description" prefWidth="260"/>
                </VBox>
            </FlowPane>
            <Button text="Search" onAction="#search" styleClass="account-outline-button"/>
        </VBox>
    </TitledPane>

    <TitledPane text="Results" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <TableView fx:id="incomeTable" prefHeight="340" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260"/>
                    <TableColumn fx:id="sourceColumn" text="Source" prefWidth="170"/>
                    <TableColumn fx:id="accountColumn" text="Account" prefWidth="190"/>
                    <TableColumn fx:id="amountColumn" text="Amount" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Open Record" onAction="#openRecord" styleClass="account-outline-button"/>
                <Button text="More Actions" onAction="#showMoreActions" styleClass="income-save-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TextArea fx:id="detailsArea" editable="false" prefRowCount="9" wrapText="true" styleClass="maintenance-result-area"/>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
