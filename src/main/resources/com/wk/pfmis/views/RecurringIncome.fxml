<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.RecurringIncomeController" styleClass="core-workspace-page income-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Recurring Income" styleClass="section-heading"/>
            <Label text="Maintain income plans that are expected to repeat. These plans do not post cash until income is recorded or marked received." wrapText="true" styleClass="form-note"/>
        </VBox>
        <Button text="+ Add Income" onAction="#openAddIncome" styleClass="primary-button"/>
        <Button text="Expected Income" onAction="#openExpectedIncome" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TitledPane text="Plan Details" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="18" vgap="10">
                <Label text="Plan Name *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="planNameField" promptText="Salary, rent income, allowance" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="Amount *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="amountField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Frequency" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="frequencyBox" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label text="Next Due Date *" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <DatePicker fx:id="nextDueDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Receiving Account *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="accountBox" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="Income Source" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <ComboBox fx:id="categoryBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Project" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="projectBox" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <Label text="Status" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <ComboBox fx:id="statusBox" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextArea fx:id="notesArea" promptText="Source notes, confirmation requirements or payroll details" prefRowCount="3" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="4"/>
            </GridPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Save Recurring Income" onAction="#savePlan" styleClass="primary-button"/>
                <Button text="Clear" onAction="#clearForm" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultLabel" text="Select a plan to edit, or create a new recurring income plan." wrapText="true" styleClass="form-note"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Recurring Income Plans" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <Label fx:id="plansStateLabel" text="No recurring income plans yet." styleClass="form-note"/>
            <TableView fx:id="plansTable" prefHeight="340" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Plan" prefWidth="220"/>
                    <TableColumn fx:id="nextDueColumn" text="Next Due" prefWidth="125"/>
                    <TableColumn fx:id="accountColumn" text="Receiving Account" prefWidth="190"/>
                    <TableColumn fx:id="sourceColumn" text="Source" prefWidth="180"/>
                    <TableColumn fx:id="amountColumn" text="Amount" prefWidth="150"/>
                    <TableColumn fx:id="frequencyColumn" text="Frequency" prefWidth="130"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
