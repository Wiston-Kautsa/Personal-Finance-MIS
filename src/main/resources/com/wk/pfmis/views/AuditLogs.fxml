<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.AuditLogsController"
      spacing="12" maxWidth="Infinity" styleClass="page-section data-record-page">
    <children>
        <VBox spacing="6" styleClass="panel data-record-hero">
            <Label text="Audit Logs" styleClass="section-heading"/>
            <Label fx:id="auditScopeLabel" text="Records include system and Smart Analysis events." wrapText="true" styleClass="form-note"/>
        </VBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="settings-status-box">
            <Label fx:id="auditSummaryLabel" text="System events: 0 | Smart Analysis requests: 0" wrapText="true" styleClass="settings-status-text" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh Logs" onAction="#refresh" minWidth="120" styleClass="secondary-button"/>
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="admin-tab-pane">
            <tabs>
                <Tab text="System Audit Records">
                    <TableView fx:id="systemLogTable" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                        <columns>
                            <TableColumn fx:id="systemLogDateColumn" text="Date / Time" prefWidth="150"/>
                            <TableColumn fx:id="systemLogModuleColumn" text="Module" prefWidth="140"/>
                            <TableColumn fx:id="systemLogActionColumn" text="Action" prefWidth="200"/>
                            <TableColumn fx:id="systemLogSeverityColumn" text="Level" prefWidth="90"/>
                            <TableColumn fx:id="systemLogDetailsColumn" text="Details" prefWidth="420"/>
                        </columns>
                    </TableView>
                </Tab>
                <Tab text="Smart Analysis Records">
                    <TableView fx:id="interactionTable" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                        <columns>
                            <TableColumn fx:id="interactionDateColumn" text="Date / Time" prefWidth="150"/>
                            <TableColumn fx:id="interactionModuleColumn" text="Module" prefWidth="140"/>
                            <TableColumn fx:id="interactionActionColumn" text="Action" prefWidth="250"/>
                            <TableColumn fx:id="interactionProviderColumn" text="Provider" prefWidth="230"/>
                            <TableColumn fx:id="interactionStatusColumn" text="Status" prefWidth="110"/>
                        </columns>
                    </TableView>
                </Tab>
            </tabs>
        </TabPane>
    </children>
    <padding>
        <Insets top="4" right="4" bottom="12" left="4"/>
    </padding>
</VBox>
