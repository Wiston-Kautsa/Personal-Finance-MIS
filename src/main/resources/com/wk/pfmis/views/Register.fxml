<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wk.pfmis.controllers.RegisterController"
            styleClass="auth-root">
    <center>
        <VBox maxWidth="690" spacing="16" alignment="CENTER_LEFT" styleClass="auth-card-wide">
            <Label fx:id="headingLabel" text="Create Your Personal PFMIS Workspace" wrapText="true" styleClass="auth-form-title"/>
            <Label fx:id="roleHintLabel" wrapText="true" styleClass="auth-hint"/>
            <GridPane hgap="16" vgap="14">
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Full name *" styleClass="form-label"/>
                    <TextField fx:id="fullNameField" promptText="e.g. Wiston Kautsa" prefWidth="300" styleClass="auth-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Username *" styleClass="form-label"/>
                    <TextField fx:id="usernameField" promptText="e.g. wkautsa" prefWidth="300" styleClass="auth-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="Email address" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="Optional email address" maxWidth="Infinity" styleClass="auth-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Password *" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="At least 8 characters" prefWidth="300" styleClass="auth-field"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Confirm password *" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" prefWidth="300" styleClass="auth-field"/>
                </VBox>
            </GridPane>
            <Label text="Password must include uppercase, lowercase and a number." wrapText="true" styleClass="auth-hint"/>
            <Label fx:id="messageLabel" wrapText="true"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Back to Sign In" onAction="#backToLogin" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Create User and Open Workspace" onAction="#register" styleClass="primary-button"/>
            </HBox>
            <padding><Insets top="38" right="42" bottom="38" left="42"/></padding>
            <BorderPane.margin><Insets top="42" right="80" bottom="42" left="80"/></BorderPane.margin>
        </VBox>
    </center>
</BorderPane>
