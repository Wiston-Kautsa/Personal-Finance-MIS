<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.SecurityHistoryController"
      spacing="14" styleClass="content-view">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="3">
            <Label text="Login and Security History" styleClass="view-title"/>
            <Label fx:id="scopeLabel" wrapText="true" styleClass="muted-label"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="authenticationTable" prefHeight="420" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="authDateColumn" text="Date" prefWidth="165"/>
            <TableColumn fx:id="authUsernameColumn" text="User" prefWidth="130"/>
            <TableColumn fx:id="authEventColumn" text="Event" prefWidth="165"/>
            <TableColumn fx:id="authResultColumn" text="Result" prefWidth="90"/>
            <TableColumn fx:id="authDetailsColumn" text="Details" prefWidth="430"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" wrapText="true" styleClass="status-message"/>
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</VBox>
