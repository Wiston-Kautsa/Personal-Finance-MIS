<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.GoalContributionController" styleClass="panel">
    <Label text="Record Contribution" styleClass="section-heading"/>

    <TitledPane text="Contribution Details" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="16" vgap="10">
                <Label text="Goal" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="goalBox" promptText="Select goal" prefWidth="340" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

                <Label text="Contribution date" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <DatePicker fx:id="contributionDatePicker" prefWidth="180" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                <Label text="Amount" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="amountField" promptText="100000" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Currency" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="currencyField" editable="false" promptText="MWK" prefWidth="120" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Contribution method" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="methodBox" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="2"/>

                <Label text="Source account" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="sourceAccountBox" promptText="Account money leaves or is allocated from" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
                <Label fx:id="sourceBalanceLabel" text="Balance: -" styleClass="form-note" GridPane.columnIndex="3" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

                <Label text="Destination account" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="destinationAccountBox" promptText="Goal or receiving account" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                <Label fx:id="destinationBalanceLabel" text="Balance: -" styleClass="form-note" GridPane.columnIndex="3" GridPane.rowIndex="4" GridPane.columnSpan="2"/>

                <Label text="Reference" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="referenceField" promptText="Receipt, transfer ID or allocation ref" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

                <Label text="Description" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" GridPane.columnSpan="4"/>
            </GridPane>

            <Label fx:id="methodNoteLabel" text="Goal contributions update the goal allocation ledger and prevent double-counting of reserved savings." wrapText="true" styleClass="form-note"/>

            <HBox spacing="8">
                <Button text="Record Contribution" onAction="#recordContribution" styleClass="primary-button"/>
                <Button text="Cancel" onAction="#clearForm" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Result" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TextArea fx:id="resultArea" editable="false" wrapText="true" prefRowCount="8"/>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
