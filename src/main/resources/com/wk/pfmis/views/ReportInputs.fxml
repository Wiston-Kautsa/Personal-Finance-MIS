<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wk.pfmis.controllers.ReportInputsController" styleClass="settings-scroll">
    <content>
        <VBox spacing="12" styleClass="settings-page">
            <Label text="Supplementary Report Inputs" styleClass="section-heading"/>
            <TitledPane text="Governance Controls" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="10" styleClass="settings-section">
                    <Label text="Use this page only for supporting information that cannot be reliably derived from validated transactions. These inputs must not override calculated income, expense, account, loan, project or budget totals." wrapText="true" styleClass="form-note"/>
                    <Label text="Active Workflow - Select workflow steps and required fields to open their control detail. Saving supporting records is operational; lifecycle controls record governed actions and keep destructive changes under confirmation, backup and audit controls." wrapText="true" styleClass="data-preview-banner"/>
                    <Label text="Required Workflow" styleClass="table-title"/>
                    <FlowPane fx:id="reportWorkflowStepsPane" hgap="10" vgap="10" prefWrapLength="980"/>
                    <Label text="Required Supplementary Input Fields" styleClass="table-title"/>
                    <FlowPane fx:id="reportWorkbenchFieldsPane" hgap="10" vgap="10" prefWrapLength="980"/>
                    <FlowPane hgap="8" vgap="8" prefWrapLength="900">
                        <Button text="New Input" onAction="#clearAllForms" minWidth="100" styleClass="secondary-button"/>
                        <Button text="Run Input Check" onAction="#validateSelectedInput" minWidth="130" styleClass="secondary-button"/>
                        <Button text="Record Submission Request" onAction="#submitSelectedInput" minWidth="190" styleClass="secondary-button"/>
                        <Button text="Record Approval Review" onAction="#approveSelectedInput" minWidth="170" styleClass="secondary-button"/>
                        <Button text="Record Rejection Review" onAction="#rejectSelectedInput" minWidth="170" styleClass="secondary-button"/>
                        <Button text="Record Freeze Request" onAction="#freezeSelectedInput" minWidth="160" styleClass="secondary-button"/>
                        <Button text="Prepare Revised Version" onAction="#createRevisedVersion" minWidth="175" styleClass="secondary-button"/>
                        <Button text="View Source" onAction="#viewSource" minWidth="110" styleClass="secondary-button"/>
                        <Button text="View History" onAction="#viewHistory" minWidth="110" styleClass="secondary-button"/>
                    </FlowPane>
                    <Label fx:id="inputGovernanceStatusLabel" text="Ready. Select a supplementary input record before applying workflow controls." wrapText="true" styleClass="settings-status-text"/>
                </VBox>
            </TitledPane>
            <TabPane tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" styleClass="admin-tab-pane">
                <tabs>
                    <Tab text="Reconciliation">
                        <VBox spacing="12" styleClass="settings-section">
                            <TitledPane text="Account Actual Balance" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
                                <VBox spacing="12">
                                    <FlowPane hgap="14" vgap="12" prefWrapLength="880">
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Account" styleClass="field-label"/>
                                            <ComboBox fx:id="reconciliationAccountBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Reconciliation Date" styleClass="field-label"/>
                                            <DatePicker fx:id="reconciliationDatePicker" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Actual Balance" styleClass="field-label"/>
                                            <TextField fx:id="actualBalanceField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field-wide">
                                            <Label text="Notes" styleClass="field-label"/>
                                            <TextArea fx:id="reconciliationNotesArea" promptText="Bank statement, cash count or mobile-money balance notes" prefRowCount="2" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Save Reconciliation" onAction="#saveReconciliation" minWidth="160" styleClass="primary-button"/>
                                        <Button text="Clear" onAction="#clearReconciliationForm" minWidth="90" styleClass="secondary-button"/>
                                        <Button fx:id="deleteReconciliationButton" text="Delete Selected" onAction="#deleteReconciliation" minWidth="130" styleClass="danger-button"/>
                                    </HBox>
                                    <Label fx:id="reconciliationStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                                </VBox>
                            </TitledPane>
                            <TableView fx:id="reconciliationTable" prefHeight="260" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                                <placeholder>
                                    <Label text="Account reconciliations will appear here." wrapText="true"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="reconciliationAccountColumn" text="Account" prefWidth="170" minWidth="170"/>
                                    <TableColumn fx:id="reconciliationDateColumn" text="Date" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="reconciliationSystemBalanceColumn" text="System Balance" prefWidth="145" minWidth="145"/>
                                    <TableColumn fx:id="reconciliationActualBalanceColumn" text="Actual Balance" prefWidth="145" minWidth="145"/>
                                    <TableColumn fx:id="reconciliationDifferenceColumn" text="Difference" prefWidth="130" minWidth="130"/>
                                    <TableColumn fx:id="reconciliationStatusColumn" text="Status" prefWidth="115" minWidth="115"/>
                                    <TableColumn fx:id="reconciliationNotesColumn" text="Notes" prefWidth="240" minWidth="220"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Obligations">
                        <VBox spacing="12" styleClass="settings-section">
                            <TitledPane text="Scheduled Obligation" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
                                <VBox spacing="12">
                                    <FlowPane hgap="14" vgap="12" prefWrapLength="880">
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Name" styleClass="field-label"/>
                                            <TextField fx:id="obligationNameField" promptText="Rent, school fees, subscription" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Type" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationTypeBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Amount" styleClass="field-label"/>
                                            <TextField fx:id="obligationAmountField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Due Date" styleClass="field-label"/>
                                            <DatePicker fx:id="obligationDueDatePicker" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Frequency" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationFrequencyBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Account" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationAccountBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Category" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationCategoryBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Project" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationProjectBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Status" styleClass="field-label"/>
                                            <ComboBox fx:id="obligationStatusBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field-wide">
                                            <Label text="Notes" styleClass="field-label"/>
                                            <TextArea fx:id="obligationNotesArea" prefRowCount="2" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Save Obligation" onAction="#saveObligation" minWidth="140" styleClass="primary-button"/>
                                        <Button text="Clear" onAction="#clearObligationForm" minWidth="90" styleClass="secondary-button"/>
                                        <Button fx:id="deleteObligationButton" text="Delete Selected" onAction="#deleteObligation" minWidth="130" styleClass="danger-button"/>
                                    </HBox>
                                    <Label fx:id="obligationStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                                </VBox>
                            </TitledPane>
                            <TableView fx:id="obligationsTable" prefHeight="260" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                                <columns>
                                    <TableColumn fx:id="obligationNameColumn" text="Name" prefWidth="190" minWidth="190"/>
                                    <TableColumn fx:id="obligationTypeColumn" text="Type" prefWidth="130" minWidth="130"/>
                                    <TableColumn fx:id="obligationAmountColumn" text="Amount" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="obligationDueDateColumn" text="Due Date" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="obligationFrequencyColumn" text="Frequency" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="obligationStatusColumn" text="Status" prefWidth="110" minWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Recurring">
                        <VBox spacing="12" styleClass="settings-section">
                            <TitledPane text="Recurring Income Or Expense Plan" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
                                <VBox spacing="12">
                                    <FlowPane hgap="14" vgap="12" prefWrapLength="880">
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Plan Name" styleClass="field-label"/>
                                            <TextField fx:id="recurringNameField" promptText="Salary, subscription, standing payment" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Type" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringTypeBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Amount" styleClass="field-label"/>
                                            <TextField fx:id="recurringAmountField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Frequency" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringFrequencyBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Next Due Date" styleClass="field-label"/>
                                            <DatePicker fx:id="recurringNextDueDatePicker" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Account" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringAccountBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Category" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringCategoryBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Project" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringProjectBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Status" styleClass="field-label"/>
                                            <ComboBox fx:id="recurringStatusBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field-wide">
                                            <Label text="Notes" styleClass="field-label"/>
                                            <TextArea fx:id="recurringNotesArea" prefRowCount="2" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Save Recurring Plan" onAction="#saveRecurring" minWidth="160" styleClass="primary-button"/>
                                        <Button text="Clear" onAction="#clearRecurringForm" minWidth="90" styleClass="secondary-button"/>
                                        <Button fx:id="deleteRecurringButton" text="Delete Selected" onAction="#deleteRecurring" minWidth="130" styleClass="danger-button"/>
                                    </HBox>
                                    <Label fx:id="recurringStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                                </VBox>
                            </TitledPane>
                            <TableView fx:id="recurringTable" prefHeight="260" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                                <columns>
                                    <TableColumn fx:id="recurringNameColumn" text="Name" prefWidth="190" minWidth="190"/>
                                    <TableColumn fx:id="recurringTypeColumn" text="Type" prefWidth="110" minWidth="110"/>
                                    <TableColumn fx:id="recurringAmountColumn" text="Amount" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="recurringFrequencyColumn" text="Frequency" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="recurringNextDueColumn" text="Next Due" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="recurringStatusColumn" text="Status" prefWidth="110" minWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Position">
                        <VBox spacing="12" styleClass="settings-section">
                            <TitledPane text="Additional Asset Or Liability" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
                                <VBox spacing="12">
                                    <FlowPane hgap="14" vgap="12" prefWrapLength="880">
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Item Name" styleClass="field-label"/>
                                            <TextField fx:id="positionNameField" promptText="Investment, receivable, credit balance" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Position Type" styleClass="field-label"/>
                                            <ComboBox fx:id="positionTypeBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Item Type" styleClass="field-label"/>
                                            <ComboBox fx:id="positionItemTypeBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Current Value" styleClass="field-label"/>
                                            <TextField fx:id="positionValueField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Valuation Date" styleClass="field-label"/>
                                            <DatePicker fx:id="positionValuationDatePicker" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Status" styleClass="field-label"/>
                                            <ComboBox fx:id="positionStatusBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field-wide">
                                            <Label text="Notes" styleClass="field-label"/>
                                            <TextArea fx:id="positionNotesArea" prefRowCount="2" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Save Position Item" onAction="#savePosition" minWidth="160" styleClass="primary-button"/>
                                        <Button text="Clear" onAction="#clearPositionForm" minWidth="90" styleClass="secondary-button"/>
                                        <Button fx:id="deletePositionButton" text="Delete Selected" onAction="#deletePosition" minWidth="130" styleClass="danger-button"/>
                                    </HBox>
                                    <Label fx:id="positionStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                                </VBox>
                            </TitledPane>
                            <TableView fx:id="positionTable" prefHeight="260" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                                <columns>
                                    <TableColumn fx:id="positionNameColumn" text="Item" prefWidth="190" minWidth="190"/>
                                    <TableColumn fx:id="positionTypeColumn" text="Position" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="positionItemTypeColumn" text="Type" prefWidth="145" minWidth="145"/>
                                    <TableColumn fx:id="positionValueColumn" text="Value" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="positionValuationDateColumn" text="Valuation Date" prefWidth="145" minWidth="145"/>
                                    <TableColumn fx:id="positionStatusColumn" text="Status" prefWidth="110" minWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Loan Schedules">
                        <VBox spacing="12" styleClass="settings-section">
                            <TitledPane text="Loan Due Date And Payment Schedule" collapsible="false" maxWidth="Infinity" styleClass="section-pane">
                                <VBox spacing="12">
                                    <FlowPane hgap="14" vgap="12" prefWrapLength="880">
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Person" styleClass="field-label"/>
                                            <ComboBox fx:id="loanPersonBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Direction" styleClass="field-label"/>
                                            <ComboBox fx:id="loanDirectionBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Principal" styleClass="field-label"/>
                                            <TextField fx:id="loanPrincipalField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Outstanding" styleClass="field-label"/>
                                            <TextField fx:id="loanOutstandingField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Interest %" styleClass="field-label"/>
                                            <TextField fx:id="loanInterestRateField" promptText="0" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Payment Amount" styleClass="field-label"/>
                                            <TextField fx:id="loanPaymentAmountField" promptText="0.00" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Due Date" styleClass="field-label"/>
                                            <DatePicker fx:id="loanDueDatePicker" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Frequency" styleClass="field-label"/>
                                            <ComboBox fx:id="loanFrequencyBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field">
                                            <Label text="Status" styleClass="field-label"/>
                                            <ComboBox fx:id="loanStatusBox" minHeight="34" maxWidth="Infinity"/>
                                        </VBox>
                                        <VBox spacing="6" styleClass="settings-field-wide">
                                            <Label text="Notes" styleClass="field-label"/>
                                            <TextArea fx:id="loanNotesArea" prefRowCount="2" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Save Loan Schedule" onAction="#saveLoanSchedule" minWidth="160" styleClass="primary-button"/>
                                        <Button text="Clear" onAction="#clearLoanForm" minWidth="90" styleClass="secondary-button"/>
                                        <Button fx:id="deleteLoanScheduleButton" text="Delete Selected" onAction="#deleteLoanSchedule" minWidth="130" styleClass="danger-button"/>
                                    </HBox>
                                    <Label fx:id="loanStatusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                                </VBox>
                            </TitledPane>
                            <TableView fx:id="loanScheduleTable" prefHeight="260" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                                <columns>
                                    <TableColumn fx:id="loanPersonColumn" text="Person" prefWidth="170" minWidth="170"/>
                                    <TableColumn fx:id="loanDirectionColumn" text="Direction" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="loanPrincipalColumn" text="Principal" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="loanOutstandingColumn" text="Outstanding" prefWidth="130" minWidth="130"/>
                                    <TableColumn fx:id="loanInterestColumn" text="Interest %" prefWidth="100" minWidth="100"/>
                                    <TableColumn fx:id="loanPaymentColumn" text="Payment" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="loanDueDateColumn" text="Due Date" prefWidth="120" minWidth="120"/>
                                    <TableColumn fx:id="loanStatusColumn" text="Status" prefWidth="110" minWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
