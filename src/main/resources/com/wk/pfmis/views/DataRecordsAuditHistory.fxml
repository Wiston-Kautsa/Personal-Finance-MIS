<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.DataRecordsSectionController"
      spacing="12" styleClass="content-view">
    <Label fx:id="sectionTitleLabel" text="Audit and History" styleClass="view-title"/>
    <TabPane fx:id="dataRecordsTabs" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="setup-tab-pane">
        <tabs>
            <Tab fx:id="activityAuditTab" text="Activity Audit"/>
            <Tab fx:id="financialRecordHistoryTab" text="Financial Record History"/>
            <Tab fx:id="authenticationHistoryTab" text="Authentication History"/>
            <Tab fx:id="administrativeActionsTab" text="Administrative Actions"/>
            <Tab fx:id="dataDisposalHistoryTab" text="Data Disposal History"/>
            <Tab fx:id="auditExportTab" text="Audit Export"/>
        </tabs>
    </TabPane>
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</VBox>
