<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.TransferMoneyController" styleClass="panel">
    <Label text="Transfer Money" styleClass="section-heading"/>

    <TitledPane text="Transfer Details" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="16" vgap="10">
                <Label text="Transfer date" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="transferDatePicker" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Status" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="statusBox" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="From account" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="fromAccountBox" promptText="Account money leaves" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="fromBalanceLabel" text="Balance: -" styleClass="form-note" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2"/>

                <Label text="To account" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="toAccountBox" promptText="Account money enters" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="toBalanceLabel" text="Balance: -" styleClass="form-note" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="2"/>

                <Label text="Amount" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="amountField" promptText="100000" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Currency" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="currencyField" editable="false" promptText="Account currency" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Transfer fee" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="feeField" promptText="0" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Fee category" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <ComboBox fx:id="feeCategoryBox" editable="true" promptText="Transaction Fees" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                <Label text="Exchange rate" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="exchangeRateField" promptText="Required for different currencies" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Payment method" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                <ComboBox fx:id="paymentMethodBox" editable="true" promptText="Bank transfer, mobile money..." prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="5"/>

                <Label text="Reference number" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="referenceField" promptText="Receipt or transaction ID" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Description" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="7" GridPane.columnSpan="3"/>
            </GridPane>

            <Label fx:id="transferCheckLabel" text="A transfer moves money between your own accounts; it is not income or an expense." styleClass="form-note"/>

            <HBox spacing="8">
                <Button text="Save Draft" onAction="#saveDraft" styleClass="secondary-button"/>
                <Button text="Transfer Money" onAction="#transferMoney" styleClass="primary-button"/>
                <Button text="Clear Form" onAction="#clearForm" styleClass="link-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Posting Result" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TextArea fx:id="resultArea" editable="false" wrapText="true" prefRowCount="7"/>
    </TitledPane>
</VBox>
