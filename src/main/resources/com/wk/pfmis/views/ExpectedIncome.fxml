<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ExpectedIncomeController">
    <Label text="Expected Income" styleClass="section-heading"/>
    <Label text="Record income expected in the future, then mark it received when the money arrives." wrapText="true" styleClass="form-note"/>

    <HBox alignment="CENTER_LEFT" spacing="18">
        <HBox spacing="18" styleClass="income-summary-card">
            <VBox spacing="4">
                <Label text="Upcoming" styleClass="metric-title"/>
                <Label fx:id="upcomingLabel" text="0" styleClass="overview-value"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Due Today" styleClass="metric-title"/>
                <Label fx:id="dueTodayLabel" text="0" styleClass="overview-value"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Overdue" styleClass="metric-title"/>
                <Label fx:id="overdueLabel" text="0" styleClass="income-summary-value"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Expected This Month" styleClass="metric-title"/>
                <Label fx:id="expectedMonthLabel" text="MWK 0.00" styleClass="overview-value"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Received This Month" styleClass="metric-title"/>
                <Label fx:id="receivedMonthLabel" text="MWK 0.00" styleClass="overview-value"/>
            </VBox>
        </HBox>
    </HBox>

    <TitledPane text="Expected Income Details" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="14">
            <GridPane hgap="24" vgap="12">
                <Label text="Expected Date *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="expectedDatePicker" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <Label text="Expected Amount *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="amountField" promptText="650000.00" prefWidth="430" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Currency" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="currencyField" editable="false" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                <Label text="Income Source *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <ComboBox fx:id="categoryBox" editable="true" promptText="Select or type income source" prefWidth="430" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Expected Account *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="accountBox" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="5"/>

                <Label text="Person or Organisation" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <ComboBox fx:id="personBox" editable="true" promptText="Optional payer" prefWidth="430" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Reference" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="referenceField" promptText="Contract, payslip or invoice reference" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="7"/>

                <Label text="Repeat Frequency" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <ComboBox fx:id="frequencyBox" prefWidth="430" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="End Date" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <DatePicker fx:id="endDatePicker" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="9"/>

                <Label text="Confidence" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                <ComboBox fx:id="confidenceBox" prefWidth="430" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                <TextArea fx:id="notesArea" prefRowCount="3" prefWidth="430" GridPane.columnIndex="0" GridPane.rowIndex="11" GridPane.columnSpan="2"/>
            </GridPane>
            <HBox spacing="10">
                <Button text="Save Expected Income" onAction="#saveExpectedIncome" styleClass="account-outline-button"/>
                <Button text="Mark as Received" onAction="#markAsReceived" styleClass="income-save-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Expected Income Schedule" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
        <TableView fx:id="expectedIncomeTable" prefHeight="300" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dateColumn" text="Expected Date" prefWidth="130"/>
                <TableColumn fx:id="sourceColumn" text="Source" prefWidth="180"/>
                <TableColumn fx:id="accountColumn" text="Account" prefWidth="200"/>
                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="150"/>
                <TableColumn fx:id="frequencyColumn" text="Frequency" prefWidth="130"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
            </columns>
        </TableView>
    </TitledPane>

    <TextArea fx:id="detailsArea" editable="false" prefRowCount="7" wrapText="true" styleClass="maintenance-result-area"/>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
