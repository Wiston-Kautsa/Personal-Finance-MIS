<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.AccountsController" styleClass="accounts-page">
    <HBox spacing="10" styleClass="account-summary-strip" VBox.vgrow="NEVER">
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Total Accounts" styleClass="metric-title"/>
            <Label fx:id="totalAccountsLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Active Accounts" styleClass="metric-title"/>
            <Label fx:id="activeAccountsOverviewLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile">
            <Label text="Needs Reconciliation" styleClass="metric-title"/>
            <Label fx:id="needsReconciliationLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile account-summary-wide">
            <Label text="Default Currency" styleClass="metric-title"/>
            <Label fx:id="defaultCurrencyLabel" text="MWK - Malawian Kwacha" wrapText="true" styleClass="overview-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" styleClass="account-summary-tile account-summary-wide">
            <Label text="Total Balance" styleClass="metric-title"/>
            <Label fx:id="totalBalanceLabel" text="-" wrapText="true" styleClass="overview-value"/>
        </VBox>
    </HBox>

    <TitledPane fx:id="accountRecordsPane" text="Account Records" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="account-table-toolbar">
                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusFilterBox" prefWidth="130" minHeight="34" prefHeight="34"/>
                <Label text="Account Type" styleClass="field-label"/>
                <ComboBox fx:id="accountTypeFilterBox" prefWidth="160" minHeight="34" prefHeight="34"/>
                <Label text="Currency" styleClass="field-label"/>
                <ComboBox fx:id="currencyFilterBox" prefWidth="130" minHeight="34" prefHeight="34"/>
                <TextField fx:id="searchField" promptText="Search account name, provider, number or purpose" prefWidth="330" maxWidth="420" minHeight="34" prefHeight="34"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="accountsTable" prefHeight="300" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Account" prefWidth="210"/>
                    <TableColumn fx:id="defaultColumn" text="Default" prefWidth="85"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="135"/>
                    <TableColumn fx:id="providerColumn" text="Provider" prefWidth="150"/>
                    <TableColumn fx:id="currencyColumn" text="Currency" prefWidth="90"/>
                    <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="135"/>
                    <TableColumn fx:id="reconciliationColumn" text="Reconciliation" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                </columns>
            </TableView>
            <VBox spacing="8" styleClass="account-action-panel">
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" prefWrapLength="900" styleClass="account-action-row">
                    <Button text="Add Account" onAction="#openNewAccountForm" minHeight="34" prefHeight="34" styleClass="account-save-button"/>
                    <Button fx:id="openAccountButton" text="Open Account" onAction="#openAccount" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button fx:id="editAccountButton" text="Edit Details" onAction="#editSelectedAccount" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button fx:id="viewLedgerButton" text="View Ledger" onAction="#viewSelectedAccountLedger" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button fx:id="reconcileButton" text="Reconcile" onAction="#reconcileAccount" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button fx:id="setDefaultButton" text="Set as Default" onAction="#setSelectedAsDefault" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button text="Refresh" onAction="#refresh" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                </FlowPane>

                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" prefWrapLength="900" styleClass="account-status-action-row">
                    <Label text="Account Status Actions:" styleClass="field-label"/>
                    <Button fx:id="freezeToggleButton" text="Freeze Account" onAction="#toggleSelectedAccountFreeze" minHeight="34" prefHeight="34" styleClass="account-outline-button"/>
                    <Button fx:id="closeAccountButton" text="Close Account" onAction="#closeSelectedAccount" minHeight="34" prefHeight="34" styleClass="account-danger-button"/>
                    <Button fx:id="archiveAccountButton" text="Archive Account" onAction="#archiveSelectedAccount" minHeight="34" prefHeight="34" styleClass="account-danger-button"/>
                </FlowPane>

                <VBox fx:id="lifecycleInlinePane" spacing="10" visible="false" managed="false"
                      maxWidth="Infinity" styleClass="account-lifecycle-inline-pane"/>
            </VBox>
            <TextArea fx:id="accountDetailsArea" editable="false" wrapText="true" prefRowCount="8" promptText="Select an account, then open it to review overview, transactions, reconciliation and history."/>
        </VBox>
    </TitledPane>

    <TitledPane fx:id="accountFormPane" text="New Account" collapsible="true" expanded="false" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="NEVER">
        <VBox spacing="12" styleClass="account-form-panel">
            <Label text="Fields marked with * are required." styleClass="required-form-note"/>
            <GridPane hgap="16" vgap="10">
                <HBox spacing="3" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Account Name" styleClass="field-label"/>
                    <Label text="*" styleClass="required-indicator"/>
                </HBox>
                <TextField fx:id="accountNameField" promptText="e.g. Main Checking Account" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <HBox spacing="3" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Account Type" styleClass="field-label"/>
                    <Label text="*" styleClass="required-indicator"/>
                </HBox>
                <ComboBox fx:id="accountTypeBox" editable="true" promptText="Cash, bank, mobile money..." minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label fx:id="providerLabel" text="Bank / Provider" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="bankProviderField" promptText="e.g. NBS Bank, Airtel Money, Cash" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                <Label fx:id="accountNumberLabel" text="Account Number" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="accountNumberField" promptText="Optional" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label fx:id="branchLabel" text="Branch" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="branchField" promptText="Optional branch" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="5"/>

                <HBox spacing="3" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label text="Currency" styleClass="field-label"/>
                    <Label text="*" styleClass="required-indicator"/>
                </HBox>
                <ComboBox fx:id="currencyBox" editable="true" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <HBox spacing="3" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="6">
                    <Label text="Opening Balance" styleClass="field-label"/>
                    <Label text="*" styleClass="required-indicator"/>
                </HBox>
                <TextField fx:id="openingBalanceField" promptText="0.00" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="7"/>

                <HBox spacing="3" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <Label text="Opening Balance Date" styleClass="field-label"/>
                    <Label text="*" styleClass="required-indicator"/>
                </HBox>
                <DatePicker fx:id="openingBalanceDatePicker" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Minimum Balance" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextField fx:id="minimumBalanceField" promptText="0.00" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="9"/>

                <Label text="Account Purpose" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                <ComboBox fx:id="accountPurposeBox" editable="true" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                <TextArea fx:id="notesArea" promptText="Optional account notes" prefRowCount="2" minHeight="64" prefHeight="64" maxHeight="64" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="11" GridPane.columnSpan="2"/>
            </GridPane>
            <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="account-form-actions">
                <Button text="Cancel" onAction="#clearForm" styleClass="account-outline-button"/>
                <Button fx:id="saveAccountButton" text="Create Account" onAction="#addAccount" styleClass="account-save-button"/>
            </HBox>
        </VBox>
    </TitledPane>
    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
