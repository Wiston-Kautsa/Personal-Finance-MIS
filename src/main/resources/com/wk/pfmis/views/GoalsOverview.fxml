<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.GoalsOverviewController" styleClass="module-overview-page goals-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Goals Overview" styleClass="section-heading"/>
            <Label text="Achievement progress, next steps and lifecycle attention for personal goals." wrapText="true" styleClass="form-note"/>
            <Label fx:id="emptyStateLabel" text="Loading goals overview..." wrapText="true" styleClass="overview-empty-state"/>
        </VBox>
        <Button text="+ Add Goal" onAction="#openAddGoal" styleClass="primary-button"/>
        <Button text="Contributions" onAction="#openGoalContributions" styleClass="secondary-button"/>
        <Button text="Steps" onAction="#openGoalSteps" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <GridPane hgap="12" vgap="12">
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Active Goals" styleClass="metric-title"/>
            <Label fx:id="activeValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Open goals being tracked" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="On Track" styleClass="metric-title"/>
            <Label fx:id="onTrackValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Goals without current risk signals" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="At Risk" styleClass="metric-title"/>
            <Label fx:id="atRiskValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Pace, deadline or status needs review" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Due Soon" styleClass="metric-title"/>
            <Label fx:id="dueSoonValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Target dates in the next 30 days" styleClass="metric-note"/>
        </VBox>
    </GridPane>

    <TitledPane text="Goal Progress" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="10">
            <Label fx:id="progressStateLabel" text="No goal records yet." styleClass="form-note"/>
            <TableView fx:id="progressTable" prefHeight="240" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="goalColumn" text="Goal" prefWidth="230"/>
                    <TableColumn fx:id="targetColumn" text="Target" prefWidth="150"/>
                    <TableColumn fx:id="allocatedColumn" text="Allocated" prefWidth="150"/>
                    <TableColumn fx:id="remainingColumn" text="Remaining" prefWidth="150"/>
                    <TableColumn fx:id="deadlineColumn" text="Target Date" prefWidth="125"/>
                    <TableColumn fx:id="progressColumn" text="Progress" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <HBox spacing="14" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <TitledPane text="Next Steps" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="stepsStateLabel" text="No unfinished goal steps." styleClass="form-note"/>
                <TableView fx:id="stepsTable" prefHeight="260" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="stepGoalColumn" text="Goal" prefWidth="200"/>
                        <TableColumn fx:id="stepNameColumn" text="Step" prefWidth="210"/>
                        <TableColumn fx:id="stepCostColumn" text="Cost" prefWidth="140"/>
                        <TableColumn fx:id="stepMissingColumn" text="Missing" prefWidth="140"/>
                        <TableColumn fx:id="stepDateColumn" text="Target Date" prefWidth="125"/>
                        <TableColumn fx:id="stepStatusColumn" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Goal History" onAction="#openGoalHistory" styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </TitledPane>
        <TitledPane text="Goal Attention" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="attentionStateLabel" text="No goals need attention." styleClass="form-note"/>
                <TableView fx:id="attentionTable" prefHeight="260" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="attentionGoalColumn" text="Goal" prefWidth="210"/>
                        <TableColumn fx:id="attentionReasonColumn" text="Reason" prefWidth="230"/>
                        <TableColumn fx:id="attentionRemainingColumn" text="Remaining" prefWidth="150"/>
                        <TableColumn fx:id="attentionRequiredColumn" text="Required" prefWidth="150"/>
                        <TableColumn fx:id="attentionDateColumn" text="Date" prefWidth="125"/>
                        <TableColumn fx:id="attentionStatusColumn" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </TitledPane>
    </HBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
