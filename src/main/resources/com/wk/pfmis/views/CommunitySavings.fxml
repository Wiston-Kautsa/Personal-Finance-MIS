<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="pageScroll"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="savings-module-scroll"
            fx:controller="com.wk.pfmis.controllers.CommunitySavingsController">
    <content>
        <VBox fx:id="page" spacing="22" styleClass="savings-module-page">
            <padding>
                <Insets top="28" right="28" bottom="32" left="28"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
