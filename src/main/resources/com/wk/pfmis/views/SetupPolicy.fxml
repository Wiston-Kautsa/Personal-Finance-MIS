<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="ALWAYS"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wk.pfmis.controllers.SetupPolicyController"
            styleClass="settings-scroll">
    <content>
        <VBox spacing="12" styleClass="settings-page">
            <VBox spacing="7" styleClass="panel">
                <Label text="Setup Configuration Centre" styleClass="section-heading"/>
                <Label fx:id="selectedAreaLabel" text="Setup area" wrapText="true" styleClass="settings-status-title"/>
                <Label fx:id="conclusionLabel" text="Setup now records decision rules, preferences, alerts, automation and governance controls." wrapText="true" styleClass="form-note"/>
            </VBox>

            <TitledPane text="Configuration Item" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="12" styleClass="settings-section">
                    <FlowPane hgap="14" vgap="12" prefWrapLength="920">
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Setup Area" styleClass="field-label"/>
                            <ComboBox fx:id="areaBox" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Item Name" styleClass="field-label"/>
                            <TextField fx:id="itemNameField" promptText="Rule, preference, alert or schedule name" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Type" styleClass="field-label"/>
                            <TextField fx:id="configTypeField" promptText="Rule, Profile, Alert, Schedule" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Condition" styleClass="field-label"/>
                            <TextField fx:id="conditionField" promptText="When should this item apply?" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Threshold / Value" styleClass="field-label"/>
                            <TextField fx:id="thresholdField" promptText="MWK 100,000 / 80% / 7 days" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Severity" styleClass="field-label"/>
                            <ComboBox fx:id="severityBox" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Target Screen" styleClass="field-label"/>
                            <TextField fx:id="targetScreenField" promptText="Accounts, Budgets, Reports" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Status" styleClass="field-label"/>
                            <ComboBox fx:id="enabledBox" minHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Recommendation" styleClass="field-label"/>
                            <TextArea fx:id="recommendationArea" prefRowCount="3" wrapText="true"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Notes / Evidence Requirement" styleClass="field-label"/>
                            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true"/>
                        </VBox>
                    </FlowPane>

                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Save" onAction="#savePolicy" minWidth="90" styleClass="primary-button"/>
                        <Button text="Clear" onAction="#clearForm" minWidth="80" styleClass="secondary-button"/>
                        <Button text="Enable Selected" onAction="#enableSelected" minWidth="125" styleClass="secondary-button"/>
                        <Button text="Disable Selected" onAction="#disableSelected" minWidth="125" styleClass="secondary-button"/>
                        <Button text="Restore Defaults" onAction="#restoreDefaults" minWidth="135" styleClass="secondary-button"/>
                    </HBox>
                    <Label fx:id="statusLabel" text="Ready." wrapText="true" styleClass="settings-status-text"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Configured Items" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="10" styleClass="settings-section">
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Test / Run Selected" onAction="#runSelectedAction" minWidth="150" styleClass="primary-button"/>
                        <Button text="Enable Area" onAction="#enableArea" minWidth="110" styleClass="secondary-button"/>
                        <Button text="Disable Area" onAction="#disableArea" minWidth="115" styleClass="secondary-button"/>
                        <Button text="Mark Reviewed" onAction="#markAllReviewed" minWidth="120" styleClass="secondary-button"/>
                        <Button text="Refresh" onAction="#refresh" minWidth="90" styleClass="secondary-button"/>
                    </HBox>
                    <TableView fx:id="policyTable" prefHeight="310" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                        <columns>
                            <TableColumn fx:id="areaColumn" text="Area" prefWidth="190" minWidth="190"/>
                            <TableColumn fx:id="itemNameColumn" text="Item" prefWidth="210" minWidth="210"/>
                            <TableColumn fx:id="configTypeColumn" text="Type" prefWidth="110" minWidth="110"/>
                            <TableColumn fx:id="conditionColumn" text="Condition" prefWidth="250" minWidth="250"/>
                            <TableColumn fx:id="thresholdColumn" text="Threshold" prefWidth="130" minWidth="130"/>
                            <TableColumn fx:id="severityColumn" text="Severity" prefWidth="100" minWidth="100"/>
                            <TableColumn fx:id="targetScreenColumn" text="Target" prefWidth="140" minWidth="140"/>
                            <TableColumn fx:id="enabledColumn" text="Status" prefWidth="110" minWidth="110"/>
                            <TableColumn fx:id="updatedColumn" text="Updated" prefWidth="160" minWidth="160"/>
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>

            <TitledPane text="System Actions And Evidence" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="10" styleClass="settings-section">
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Run Full Data Check" onAction="#runFullDataCheck" minWidth="150" styleClass="primary-button"/>
                        <Button text="Check Database Integrity" onAction="#checkDatabaseIntegrity" minWidth="175" styleClass="secondary-button"/>
                        <Button text="Backup Now" onAction="#backupNow" minWidth="110" styleClass="secondary-button"/>
                        <Button text="Open Backup Folder" onAction="#openBackupFolder" minWidth="155" styleClass="secondary-button"/>
                        <Button text="View Run History" onAction="#viewRunHistory" minWidth="135" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="setupResultArea" prefRowCount="9" wrapText="false" editable="false" text="Run a setup action to see evidence and results."/>
                </VBox>
            </TitledPane>

            <padding>
                <Insets top="4" right="4" bottom="12" left="4"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
