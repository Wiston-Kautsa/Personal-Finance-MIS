<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ProjectFinancesController" styleClass="core-workspace-page project-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Project Finances" styleClass="section-heading"/>
            <Label text="Read project budget, actual spending and linked project transactions. Expense posting remains in the central transaction workflow." wrapText="true" styleClass="form-note"/>
        </VBox>
        <Button text="+ Record Project Expense" onAction="#recordProjectExpense" styleClass="primary-button"/>
        <Button text="Activities" onAction="#openActivities" styleClass="secondary-button"/>
        <Button text="Milestones" onAction="#openMilestones" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TitledPane text="Project Position" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Project" styleClass="field-label"/>
                <ComboBox fx:id="projectBox" promptText="Choose project" minWidth="300"/>
            </HBox>
            <GridPane hgap="12" vgap="12">
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Planned Budget" styleClass="metric-title"/>
                    <Label fx:id="plannedBudgetLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Actual Spend" styleClass="metric-title"/>
                    <Label fx:id="actualSpendLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Remaining" styleClass="metric-title"/>
                    <Label fx:id="remainingBudgetLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Variance" styleClass="metric-title"/>
                    <Label fx:id="varianceLabel" text="-" styleClass="overview-value"/>
                </VBox>
            </GridPane>
            <TextArea fx:id="financeArea" editable="false" wrapText="true" prefRowCount="7"/>
        </VBox>
    </TitledPane>

    <HBox spacing="14" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <TitledPane text="Linked Project Transactions" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="transactionStateLabel" text="No project transactions." styleClass="form-note"/>
                <TableView fx:id="transactionsTable" prefHeight="360" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="transactionDateColumn" text="Date" prefWidth="125"/>
                        <TableColumn fx:id="transactionDescriptionColumn" text="Description" prefWidth="240"/>
                        <TableColumn fx:id="transactionTypeColumn" text="Type" prefWidth="130"/>
                        <TableColumn fx:id="transactionAccountColumn" text="Account" prefWidth="180"/>
                        <TableColumn fx:id="transactionAmountColumn" text="Amount" prefWidth="145"/>
                        <TableColumn fx:id="transactionActivityColumn" text="Activity" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </TitledPane>
        <TitledPane text="Activity Cost Position" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="activityCostStateLabel" text="No project activities." styleClass="form-note"/>
                <TableView fx:id="activityCostTable" prefHeight="360" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="activityNameColumn" text="Activity" prefWidth="220"/>
                        <TableColumn fx:id="activityPlannedColumn" text="Planned" prefWidth="145"/>
                        <TableColumn fx:id="activityActualColumn" text="Actual" prefWidth="145"/>
                        <TableColumn fx:id="activityProgressColumn" text="Progress" prefWidth="130"/>
                        <TableColumn fx:id="activityStatusColumn" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </TitledPane>
    </HBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
