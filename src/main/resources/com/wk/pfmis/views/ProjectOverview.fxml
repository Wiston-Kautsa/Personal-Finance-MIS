<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ProjectOverviewController" styleClass="module-overview-page project-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Project Overview" styleClass="section-heading"/>
            <Label text="Project execution, money used, milestones and activity signals in one workspace." wrapText="true" styleClass="form-note"/>
            <Label fx:id="emptyStateLabel" text="Loading project overview..." wrapText="true" styleClass="overview-empty-state"/>
        </VBox>
        <Button text="+ Add Project" onAction="#openAddProject" styleClass="primary-button"/>
        <Button text="Activities" onAction="#openProjectActivities" styleClass="secondary-button"/>
        <Button text="Finances" onAction="#openProjectFinances" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <GridPane hgap="12" vgap="12">
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Active Projects" styleClass="metric-title"/>
            <Label fx:id="activeValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Current workspaces" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="At Risk" styleClass="metric-title"/>
            <Label fx:id="atRiskValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Budget, date or status signals" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Overdue Activities" styleClass="metric-title"/>
            <Label fx:id="overdueValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Activities past end date" styleClass="metric-note"/>
        </VBox>
        <VBox styleClass="metric-card overview-metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Upcoming Milestones" styleClass="metric-title"/>
            <Label fx:id="milestonesValueLabel" text="0" styleClass="metric-value"/>
            <Label text="Milestones due in 30 days" styleClass="metric-note"/>
        </VBox>
    </GridPane>

    <TitledPane text="Project Portfolio" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="10">
            <Label fx:id="projectsStateLabel" text="No project records yet." styleClass="form-note"/>
            <TableView fx:id="projectsTable" prefHeight="245" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="projectColumn" text="Project" prefWidth="230"/>
                    <TableColumn fx:id="plannedColumn" text="Planned Budget" prefWidth="150"/>
                    <TableColumn fx:id="actualColumn" text="Actual Spend" prefWidth="150"/>
                    <TableColumn fx:id="progressColumn" text="Progress" prefWidth="150"/>
                    <TableColumn fx:id="milestoneColumn" text="Next Milestone" prefWidth="240"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <HBox spacing="14" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <TitledPane text="Attention" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="attentionStateLabel" text="No projects need attention." styleClass="form-note"/>
                <TableView fx:id="attentionTable" prefHeight="260" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="attentionProjectColumn" text="Project" prefWidth="210"/>
                        <TableColumn fx:id="attentionReasonColumn" text="Reason" prefWidth="250"/>
                        <TableColumn fx:id="attentionGapColumn" text="Budget Gap" prefWidth="150"/>
                        <TableColumn fx:id="attentionRemainingColumn" text="Remaining" prefWidth="150"/>
                        <TableColumn fx:id="attentionDateColumn" text="Date" prefWidth="125"/>
                        <TableColumn fx:id="attentionStatusColumn" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Milestones &amp; Status" onAction="#openMilestonesStatus" styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </TitledPane>
        <TitledPane text="Recent Project Activity" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="activityStateLabel" text="No recent project activity." styleClass="form-note"/>
                <TableView fx:id="activityTable" prefHeight="260" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="activityDateColumn" text="Date" prefWidth="125"/>
                        <TableColumn fx:id="activityProjectColumn" text="Project" prefWidth="190"/>
                        <TableColumn fx:id="activityNameColumn" text="Activity" prefWidth="210"/>
                        <TableColumn fx:id="activityAmountColumn" text="Amount Used" prefWidth="150"/>
                        <TableColumn fx:id="activityProgressColumn" text="Progress" prefWidth="130"/>
                        <TableColumn fx:id="activityStatusColumn" text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Project History" onAction="#openProjectHistory" styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </TitledPane>
    </HBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
