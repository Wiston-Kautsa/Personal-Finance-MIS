<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ProjectActivitiesController">
    <TitledPane text="Record Activity" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="14">
            <FlowPane hgap="14" vgap="12" prefWrapLength="920">
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Project" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="projectBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Activity Name" wrapText="true" styleClass="field-label"/>
                    <TextField fx:id="activityNameField" promptText="e.g. Buy equipment" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Activity Type" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="activityTypeBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Activity Date" wrapText="true" styleClass="field-label"/>
                    <DatePicker fx:id="activityDatePicker" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Planned Start" wrapText="true" styleClass="field-label"/>
                    <DatePicker fx:id="plannedStartDatePicker" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Planned Completion" wrapText="true" styleClass="field-label"/>
                    <DatePicker fx:id="plannedCompletionDatePicker" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Actual Completion" wrapText="true" styleClass="field-label"/>
                    <DatePicker fx:id="actualCompletionDatePicker" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Planned Cost" wrapText="true" styleClass="field-label"/>
                    <TextField fx:id="plannedCostField" promptText="0.00" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Responsible Person" wrapText="true" styleClass="field-label"/>
                    <TextField fx:id="responsiblePersonField" promptText="Optional" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Priority" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="priorityBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Progress" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="progressBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Status" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="statusBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field">
                    <Label text="Project Status" wrapText="true" styleClass="field-label"/>
                    <ComboBox fx:id="projectStatusBox" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field-wide">
                    <Label text="Attachment / Evidence" wrapText="true" styleClass="field-label"/>
                    <TextField fx:id="evidenceField" promptText="Reference, receipt, or file note" minHeight="34" prefHeight="34" maxHeight="34" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field-wide">
                    <Label text="Description" wrapText="true" styleClass="field-label"/>
                    <TextArea fx:id="descriptionArea" promptText="Work to be performed or work completed" wrapText="true" prefRowCount="3" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="settings-field-wide">
                    <Label text="Notes" wrapText="true" styleClass="field-label"/>
                    <TextArea fx:id="reasonArea" promptText="Reason, blockers, or supporting notes" wrapText="true" prefRowCount="3" maxWidth="Infinity"/>
                </VBox>
            </FlowPane>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Save Activity" onAction="#saveActivity" minWidth="125" styleClass="income-save-button"/>
                <Button text="Record Expense" onAction="#recordExpense" minWidth="135" styleClass="income-save-button"/>
                <Button text="Clear" onAction="#clearForm" minWidth="90" styleClass="account-outline-button"/>
                <Button text="Refresh" onAction="#refresh" minWidth="90" styleClass="account-outline-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Selected Project Activities" collapsible="true" expanded="true" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="section-pane">
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="account-table-toolbar">
                <Label text="Project" styleClass="field-label"/>
                <ComboBox fx:id="activityListProjectBox" promptText="Choose project" prefWidth="430" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="activitiesTable" prefHeight="300" VBox.vgrow="ALWAYS" styleClass="project-list-table">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="105"/>
                    <TableColumn fx:id="projectColumn" text="Project" prefWidth="170"/>
                    <TableColumn fx:id="activityColumn" text="Activity" prefWidth="210"/>
                    <TableColumn fx:id="plannedCostColumn" text="Planned Cost" prefWidth="130"/>
                    <TableColumn fx:id="actualCostColumn" text="Actual Cost" prefWidth="130"/>
                    <TableColumn fx:id="progressColumn" text="Progress" prefWidth="95"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="reasonColumn" text="Notes / Evidence" prefWidth="320"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
