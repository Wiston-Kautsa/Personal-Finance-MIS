<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.RegisterAssetController" styleClass="accounts-page">
    <TitledPane text="Register Asset" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12" styleClass="account-form-panel">
            <Label text="Fields marked with * are required." styleClass="required-form-note"/>
            <FlowPane hgap="14" vgap="12" prefWrapLength="900">
                <VBox spacing="6" styleClass="settings-field-wide">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Asset Name" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <TextField fx:id="assetNameField" promptText="e.g. Refrigerator, Laptop, Land parcel" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Asset Category" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <ComboBox fx:id="assetCategoryBox" editable="true" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Acquisition Method" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <ComboBox fx:id="acquisitionMethodBox" editable="true" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Acquisition Date" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <DatePicker fx:id="purchaseDatePicker" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Unit Cost or Value" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <TextField fx:id="purchaseCostField" promptText="0.00" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Currency" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <ComboBox fx:id="currencyBox" editable="true" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" styleClass="settings-field-wide">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Payment Treatment" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <ComboBox fx:id="paymentTreatmentBox" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="payingAccountSection" spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Paying Account" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <ComboBox fx:id="payingAccountBox" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="transactionIdSection" spacing="6" styleClass="settings-field">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Existing Transaction ID" styleClass="field-label"/>
                        <Label text="*" styleClass="required-indicator"/>
                    </HBox>
                    <TextField fx:id="transactionIdField" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                </VBox>
            </FlowPane>

            <TitledPane text="Optional Asset Details" collapsible="true" expanded="false" maxWidth="Infinity" styleClass="section-pane">
                <VBox spacing="12" styleClass="settings-section">
                    <FlowPane hgap="14" vgap="12" prefWrapLength="900">
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Quantity" styleClass="field-label"/>
                            <TextField fx:id="quantityField" promptText="1" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Capitalized Costs" styleClass="field-label"/>
                            <TextField fx:id="capitalizedCostsField" promptText="Delivery, installation, registration..." minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Condition" styleClass="field-label"/>
                            <ComboBox fx:id="conditionBox" editable="true" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Supplier or Source" styleClass="field-label"/>
                            <TextField fx:id="supplierField" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Payment Method" styleClass="field-label"/>
                            <ComboBox fx:id="paymentMethodBox" editable="true" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Reference Number" styleClass="field-label"/>
                            <TextField fx:id="referenceNumberField" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Serial or Registration Number" styleClass="field-label"/>
                            <TextField fx:id="serialNumberField" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field">
                            <Label text="Location" styleClass="field-label"/>
                            <TextField fx:id="locationField" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Receipt or Attachment" styleClass="field-label"/>
                            <TextField fx:id="supportingDocumentField" promptText="Receipt, invoice or document reference" minHeight="34" prefHeight="34" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" styleClass="settings-field-wide">
                            <Label text="Notes" styleClass="field-label"/>
                            <TextArea fx:id="notesArea" wrapText="true" prefRowCount="3" maxWidth="Infinity"/>
                        </VBox>
                    </FlowPane>
                </VBox>
            </TitledPane>

            <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="account-form-actions">
                <Button text="Refresh Accounts" onAction="#refreshLinkedData" styleClass="account-outline-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Clear" onAction="#clearForm" styleClass="account-outline-button"/>
                <Button text="Register Asset" onAction="#registerAsset" styleClass="account-save-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Registration Result" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TextArea fx:id="resultArea" editable="false" wrapText="true" prefRowCount="8"
                  promptText="Registration results, linked transaction notes and allocation differences appear here."/>
    </TitledPane>
    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
