<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.LoanRepaymentController" styleClass="panel">
    <Label text="Record Repayment" styleClass="section-heading"/>

    <TitledPane text="Repayment Details" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="16" vgap="10">
                <Label text="Repayment mode *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="eventBox" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label fx:id="personLabel" text="Lender" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="personBox" editable="true" promptText="Filter by lender" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Loan *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="loanBox" promptText="Select loan" prefWidth="420" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                <Label fx:id="loanBalanceLabel" text="Outstanding: -" styleClass="form-note" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Payment date *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="paymentDatePicker" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label fx:id="accountLabel" text="Payment account *" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="accountBox" promptText="Select account" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Payment method" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="paymentMethodBox" editable="true" promptText="Cash, bank transfer..." prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label fx:id="accountBalanceLabel" text="Account balance: -" styleClass="form-note" GridPane.columnIndex="2" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

                <Label text="Amount being paid *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="totalAmountField" promptText="110000" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Principal portion" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="principalField" promptText="100000" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                <Label fx:id="interestLabel" text="Interest portion" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="interestField" promptText="0" prefWidth="190" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label fx:id="penaltyLabel" text="Penalty portion" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                <TextField fx:id="penaltyField" promptText="0" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="5"/>

                <Label text="Reference" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="referenceField" promptText="Receipt or transaction ID" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextArea fx:id="notesArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="7" GridPane.columnSpan="3"/>
            </GridPane>

            <Label fx:id="allocationLabel" text="Principal reduces the loan balance. Interest, penalties and fees are recorded separately." wrapText="true" styleClass="form-note"/>

            <HBox spacing="8">
                <Button text="Record Repayment" onAction="#recordRepayment" styleClass="primary-button"/>
                <Button text="Clear Form" onAction="#clearForm" styleClass="link-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Result" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TextArea fx:id="resultArea" editable="false" wrapText="true" prefRowCount="8"/>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
