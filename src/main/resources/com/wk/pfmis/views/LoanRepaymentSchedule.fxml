<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.LoanRepaymentScheduleController" styleClass="panel">
    <Label text="Repayment Schedule" styleClass="section-heading"/>

    <TitledPane text="Filters" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <GridPane hgap="16" vgap="10">
            <Label text="Source type" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="viewFilterBox" prefWidth="170" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Period" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="periodFilterBox" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Status" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="statusFilterBox" prefWidth="170" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Lender" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="personFilterBox" editable="true" promptText="All lenders" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Search" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="searchField" promptText="Loan number, lender or source" prefWidth="420" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="Scheduled Repayments" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <TableView fx:id="scheduleTable" prefHeight="320" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dueDateColumn" text="Due date" prefWidth="120"/>
                    <TableColumn fx:id="loanColumn" text="Loan" prefWidth="90"/>
                    <TableColumn fx:id="personColumn" text="Lender" prefWidth="190"/>
                    <TableColumn fx:id="directionColumn" text="Source" prefWidth="160"/>
                    <TableColumn fx:id="expectedAmountColumn" text="Remaining due" prefWidth="160"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button text="Open Loan" onAction="#openLoan" styleClass="secondary-button"/>
                <Button text="Record Repayment" onAction="#recordRepayment" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Schedule Notes" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="9"/>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
