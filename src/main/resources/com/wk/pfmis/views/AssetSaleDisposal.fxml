<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.AssetSaleDisposalController" styleClass="core-workspace-page asset-workspace">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Sale &amp; Disposal" styleClass="section-heading"/>
            <Label text="Record sale proceeds through the existing transaction system, or close an asset by disposal, write-off or loss." wrapText="true" styleClass="form-note"/>
        </VBox>
        <Button text="Confirm Sale" onAction="#confirmSale" styleClass="primary-button"/>
        <Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/>
    </HBox>

    <TitledPane text="Selected Asset" collapsible="false" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Asset" styleClass="field-label"/>
                <ComboBox fx:id="assetBox" promptText="Choose asset" minWidth="300"/>
            </HBox>
            <GridPane hgap="12" vgap="12">
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Status" styleClass="metric-title"/>
                    <Label fx:id="statusLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Condition" styleClass="metric-title"/>
                    <Label fx:id="conditionLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Current Value" styleClass="metric-title"/>
                    <Label fx:id="valueLabel" text="-" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="compact-metric-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Location" styleClass="metric-title"/>
                    <Label fx:id="locationLabel" text="-" styleClass="overview-value"/>
                </VBox>
            </GridPane>
        </VBox>
    </TitledPane>

    <TitledPane text="Sale or Disposal Details" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <GridPane hgap="18" vgap="10">
                <Label text="Sale Type" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="saleTypeBox" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="Date *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <DatePicker fx:id="saleDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Buyer / Counterparty" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="buyerField" promptText="Buyer, recipient or approver" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label text="Receiving Account *" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <ComboBox fx:id="receivingAccountBox" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Sale Price" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="salePriceField" promptText="0.00" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="Selling Costs" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="sellingCostsField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Payment Option" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="paymentOptionBox" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <Label text="Amount Received" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <TextField fx:id="amountReceivedField" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Due Date" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="dueDateField" promptText="YYYY-MM-DD when unpaid" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label text="Quantity Sold" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <TextField fx:id="quantitySoldField" promptText="1" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Value Removed" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="valueRemovedField" promptText="0.00" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                <Label text="Payment Method" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                <ComboBox fx:id="paymentMethodBox" GridPane.columnIndex="3" GridPane.rowIndex="5"/>

                <Label text="Reason *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="reasonField" promptText="Sale, disposal, write-off reason" GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2"/>
                <Label text="Reference" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                <TextField fx:id="referenceField" promptText="Receipt or approval reference" GridPane.columnIndex="2" GridPane.rowIndex="7"/>
                <Label text="Supporting Document" styleClass="field-label" GridPane.columnIndex="3" GridPane.rowIndex="6"/>
                <TextField fx:id="supportingDocumentField" promptText="File or document reference" GridPane.columnIndex="3" GridPane.rowIndex="7"/>
                <Label text="Notes" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.columnSpan="4"/>
            </GridPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Confirm Sale" onAction="#confirmSale" styleClass="primary-button"/>
                <Button text="Mark Disposed" onAction="#markDisposed" styleClass="secondary-button"/>
                <Button text="Write Off" onAction="#writeOffAsset" styleClass="secondary-button"/>
                <Button text="Mark Lost" onAction="#markLost" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultLabel" text="Sale creates receipt transactions once confirmed; disposal/write-off does not create income." wrapText="true" styleClass="form-note"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Sale and Disposal History" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <Label fx:id="eventStateLabel" text="No asset events yet." styleClass="form-note"/>
            <TableView fx:id="eventTable" prefHeight="300" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="eventDateColumn" text="Date" prefWidth="125"/>
                    <TableColumn fx:id="eventTypeColumn" text="Event" prefWidth="160"/>
                    <TableColumn fx:id="eventAmountColumn" text="Amount" prefWidth="145"/>
                    <TableColumn fx:id="eventCounterpartyColumn" text="Counterparty" prefWidth="180"/>
                    <TableColumn fx:id="eventTransactionColumn" text="Transaction" prefWidth="130"/>
                    <TableColumn fx:id="eventStatusColumn" text="Status" prefWidth="130"/>
                    <TableColumn fx:id="eventNotesColumn" text="Notes" prefWidth="320"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
