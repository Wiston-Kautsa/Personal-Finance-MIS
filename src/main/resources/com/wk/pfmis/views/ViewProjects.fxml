<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.wk.pfmis.controllers.ViewProjectsController">
    <TitledPane text="Selected Project" collapsible="true" expanded="true" maxWidth="Infinity" styleClass="section-pane">
        <VBox spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="account-table-toolbar">
                <Label text="Project" styleClass="field-label"/>
                <ComboBox fx:id="summaryProjectBox" prefWidth="430" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="34"/>
                    <ColumnConstraints percentWidth="66"/>
                </columnConstraints>

                <VBox spacing="10" styleClass="project-detail-panel" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Project" styleClass="metric-title"/>
                    <Label fx:id="projectNameLabel" text="No Project Selected" wrapText="true" styleClass="project-detail-title"/>
                    <GridPane hgap="14" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                        </columnConstraints>
                        <Label text="Status" styleClass="metric-title" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Start Date" styleClass="metric-title" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="End Date" styleClass="metric-title" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="project-status-value" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="startDateLabel" text="-" wrapText="true" styleClass="overview-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="endDateLabel" text="-" wrapText="true" styleClass="overview-value" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                    <VBox spacing="4">
                        <Label text="Description" styleClass="field-label"/>
                        <Label fx:id="descriptionLabel" text="-" wrapText="true" styleClass="form-note"/>
                    </VBox>
                </VBox>

                <VBox spacing="8" styleClass="project-detail-panel" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Recent Activities" styleClass="table-title"/>
                    <TableView fx:id="recentActivitiesTable" prefHeight="170">
                        <columns>
                            <TableColumn fx:id="activityDateColumn" text="Date" prefWidth="110"/>
                            <TableColumn fx:id="activityNameColumn" text="Activity" prefWidth="230"/>
                            <TableColumn fx:id="activityStatusColumn" text="Status" prefWidth="130"/>
                            <TableColumn fx:id="activityNotesColumn" text="Notes" prefWidth="460"/>
                        </columns>
                    </TableView>
                </VBox>
            </GridPane>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="16.6"/>
                    <ColumnConstraints percentWidth="16.6"/>
                    <ColumnConstraints percentWidth="16.6"/>
                    <ColumnConstraints percentWidth="16.6"/>
                    <ColumnConstraints percentWidth="16.6"/>
                    <ColumnConstraints percentWidth="17"/>
                </columnConstraints>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Total Activities" styleClass="metric-title"/>
                    <Label fx:id="totalActivitiesLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Total Spent" styleClass="metric-title"/>
                    <Label fx:id="totalSpentLabel" text="MWK 0.00" styleClass="income-summary-value"/>
                </VBox>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Avg Expense / Activity" styleClass="metric-title"/>
                    <Label fx:id="averageActivityCostLabel" text="MWK 0.00" styleClass="income-summary-value"/>
                </VBox>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Last Activity" styleClass="metric-title"/>
                    <Label fx:id="lastActivityLabel" text="-" wrapText="true" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="4" GridPane.rowIndex="0">
                    <Label text="Top Expense Category" styleClass="metric-title"/>
                    <Label fx:id="mostUsedCategoryLabel" text="-" wrapText="true" styleClass="overview-value"/>
                </VBox>
                <VBox styleClass="metric-card compact-metric-card project-metric-card" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0">
                    <Label text="Accounts Used" styleClass="metric-title"/>
                    <Label fx:id="accountsUsedLabel" text="-" wrapText="true" styleClass="overview-value"/>
                </VBox>
            </GridPane>
        </VBox>
    </TitledPane>

    <TitledPane text="All Projects" collapsible="true" expanded="true" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="section-pane">
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="projectSearchField" promptText="Search projects..." prefWidth="260"/>
                <ComboBox fx:id="statusFilterBox" prefWidth="180"/>
            </HBox>
            <TableView fx:id="projectsTable" prefHeight="280" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Project" prefWidth="190"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="activityCountColumn" text="Activities" prefWidth="90"/>
                    <TableColumn fx:id="spentColumn" text="Total Spent" prefWidth="140"/>
                    <TableColumn fx:id="lastActivityColumn" text="Last Activity" prefWidth="130"/>
                    <TableColumn fx:id="startDateColumn" text="Start Date" prefWidth="110"/>
                    <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
