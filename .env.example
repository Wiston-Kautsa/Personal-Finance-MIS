# PFMIS environment template
#
# Copy this file to .env only on a private target machine when local SMTP/IMAP
# settings are required. Never commit or package .env.
#
# PFMIS has no default administrator password. The first local account created
# in a clean installation becomes the Super Administrator.

# Mail settings are optional. Prefer operating-system credential storage for
# secrets where available. If Gmail is used, create a dedicated Gmail App
# Password and rotate it if it was ever exposed.
PFMIS_MAIL_FROM=sender@example.invalid
PFMIS_MAIL_REPLY_TO=reply-to@example.invalid
PFMIS_MAIL_USERNAME=sender@example.invalid
PFMIS_MAIL_PASSWORD=replace-with-private-app-password
PFMIS_SMTP_HOST=smtp.gmail.com
PFMIS_SMTP_PORT=587
PFMIS_SMTP_STARTTLS=true
PFMIS_SMTP_SSL=false
PFMIS_IMAP_HOST=imap.gmail.com
PFMIS_IMAP_PORT=993
PFMIS_IMAP_SSL=true

# External AI provider keys are not loaded from .env. Configure them in the
# application so they can be stored per workspace. Keep bundled local AI as the
# default when the runtime and model are installed.
