# PFMIS environment template
#
# Copy to a private .env only when machine-level configuration is required.
# PFMIS also creates a safe local .env in the writable application-data
# directory on first installed startup. Never commit a real .env file.

# Application
PFMIS_APP_ENV=production

# Foreign Exchange
PFMIS_FX_ENABLED=true
PFMIS_FX_PROVIDER=FRANKFURTER
PFMIS_FX_BASE_URL=https://api.frankfurter.dev/v2
PFMIS_FX_API_KEY=
PFMIS_FX_MWK_PREFERRED_SOURCE=RBM
PFMIS_FX_REFRESH_MINUTES=360
PFMIS_FX_REFRESH_ON_STARTUP=true

# Foreign Exchange Network
PFMIS_FX_CONNECT_TIMEOUT_SECONDS=10
PFMIS_FX_REQUEST_TIMEOUT_SECONDS=20
PFMIS_FX_MAX_RETRIES=2
PFMIS_FX_RETRY_DELAY_MILLISECONDS=1500
PFMIS_FX_MAX_CONCURRENT_REQUESTS=3
PFMIS_FX_USER_AGENT=PFMIS/1.0

# Foreign Exchange Cache
PFMIS_FX_USE_CACHED_WHEN_OFFLINE=true
PFMIS_FX_CACHE_ENABLED=true
PFMIS_FX_STALE_AFTER_HOURS=24
PFMIS_FX_VALIDATE_RESPONSES=true
PFMIS_FX_RATE_SCALE=10

# Historical Rates
PFMIS_FX_HISTORICAL_ENABLED=true
PFMIS_FX_HISTORICAL_CACHE_FALLBACK=true
PFMIS_FX_HISTORY_RETENTION_DAYS=0

# Fallback Provider
PFMIS_FX_FALLBACK_PROVIDER=
PFMIS_FX_FALLBACK_BASE_URL=
PFMIS_FX_FALLBACK_API_KEY=

# Local AI
PFMIS_LOCAL_AI_ENABLED=true
PFMIS_LOCAL_AI_HOST=127.0.0.1
PFMIS_LOCAL_AI_PORT=8080
PFMIS_LOCAL_AI_CONTEXT_SIZE=2048
PFMIS_LOCAL_AI_STARTUP_TIMEOUT_SECONDS=120
PFMIS_LOCAL_AI_HEALTH_POLL_MILLISECONDS=1000
PFMIS_LOCAL_AI_REQUEST_TIMEOUT_SECONDS=10
PFMIS_LOCAL_AI_DIR=

# Initial Super Administrator
PFMIS_SUPER_ADMIN_EMAIL=admin@example.com
PFMIS_SUPER_ADMIN_PASSWORD=

# Mail
PFMIS_MAIL_ENABLED=false
PFMIS_MAIL_CONNECT_TIMEOUT_SECONDS=15
PFMIS_MAIL_READ_TIMEOUT_SECONDS=30
PFMIS_MAIL_WRITE_TIMEOUT_SECONDS=30
PFMIS_SYSTEM_EMAIL=system@example.com
PFMIS_EMAIL_FROM_NAME=PFMIS
PFMIS_EMAIL_REPLY_TO=
PFMIS_SMTP_HOST=smtp.example.com
PFMIS_SMTP_PORT=587
PFMIS_SMTP_USERNAME=
PFMIS_SMTP_PASSWORD=
PFMIS_SMTP_AUTH=true
PFMIS_SMTP_STARTTLS=true
PFMIS_SMTP_SSL=false
PFMIS_IMAP_HOST=imap.example.com
PFMIS_IMAP_PORT=993
PFMIS_IMAP_SSL=true

# Legacy mail aliases kept for older local configurations.
PFMIS_MAIL_FROM=
PFMIS_MAIL_REPLY_TO=
PFMIS_MAIL_USERNAME=
PFMIS_MAIL_PASSWORD=

# Logging
PFMIS_LOG_LEVEL=INFO
PFMIS_LOG_RETENTION_DAYS=30
